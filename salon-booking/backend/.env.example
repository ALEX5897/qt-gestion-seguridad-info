# Base de datos
DATABASE_URL="mysql://salon_user:salon_password@localhost:3306/salon_db"

# Autenticación del panel
JWT_SECRET="cambia-esto-por-un-secreto-largo"
JWT_EXPIRES_IN="12h"

# WhatsApp
#   console = simulador local (no envía nada, imprime en consola)
#   meta    = WhatsApp Cloud API de Meta (número de prueba gratuito o número real)
#   baileys = sesión NO OFICIAL tipo WhatsApp Web, se vincula desde el panel con QR o código.
#             Solo para pruebas: incumple los términos de WhatsApp y el número puede ser bloqueado.
WHATSAPP_PROVIDER="console"
META_GRAPH_VERSION="v23.0"
META_ACCESS_TOKEN=""
META_APP_SECRET=""
META_VERIFY_TOKEN="token-de-verificacion-del-webhook"

PORT=3001

# Tareas automáticas (recordatorios, cancelación sin confirmar, fila de espera). "false" las apaga.
AUTOMATION_ENABLED="true"

# Plantillas aprobadas en Meta para escribir fuera de la ventana de 24 h (ver docs/WHATSAPP_META.md).
# Si se dejan vacías se envía el mensaje normal, que Meta solo entrega dentro de las 24 h.
META_TEMPLATE_CONFIRMATION=""
META_TEMPLATE_WAITLIST=""
META_TEMPLATE_LANG="es"

# Inteligencia artificial (opcional). Sin clave, el bot funciona solo con botones.
# Clave de la API de Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=""
# Modelo de Claude. El predeterminado es el más capaz de su línea; uno más económico reduce el costo por respuesta.
AI_MODEL="claude-opus-5-5"
# "false" apaga la IA en toda la plataforma.
AI_ENABLED="true"
# Plantilla (categoría Marketing) para invitar a volver a clientes inactivos.
META_TEMPLATE_WINBACK=""

# Modo baileys: carpeta de las sesiones vinculadas y proxy de salida opcional (si no, usa HTTPS_PROXY).
WA_SESSIONS_DIR=".wa-sessions"
# WA_PROXY=""
